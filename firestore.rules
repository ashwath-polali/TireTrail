rules_version = '2';

// Paste all of this into Firebase console > Firestore Database > Rules, then Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // Each person's own backup: only they can read or write it.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Community totals: anyone can read; signed-in drivers add one drive at a time.
    match /community/totals {
      function fields() {
        return ['drives', 'smoothStops', 'salmonSmoothStops', 'miles', 'updated'];
      }
      function shaped(d) {
        return d.keys().hasOnly(fields()) && d.keys().hasAll(fields())
          && d.drives is int && d.smoothStops is number && d.salmonSmoothStops is number && d.miles is number;
      }
      // goes up by at least 0 and at most max
      function upBy(key, max) {
        return request.resource.data[key] >= resource.data[key]
          && request.resource.data[key] <= resource.data[key] + max;
      }

      allow read: if true;

      allow create: if request.auth != null
        && shaped(request.resource.data)
        && request.resource.data.drives == 1
        && request.resource.data.smoothStops >= 0 && request.resource.data.smoothStops <= 60
        && request.resource.data.salmonSmoothStops >= 0 && request.resource.data.salmonSmoothStops <= 60
        && request.resource.data.miles >= 0 && request.resource.data.miles <= 300
        && request.resource.data.updated == request.time;

      allow update: if request.auth != null
        && shaped(request.resource.data)
        && request.resource.data.drives == resource.data.drives + 1
        && upBy('smoothStops', 60)
        && upBy('salmonSmoothStops', 60)
        && upBy('miles', 300)
        && request.resource.data.updated == request.time;

      allow delete: if false;
    }
  }
}
