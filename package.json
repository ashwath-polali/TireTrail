{
  "name": "tiretrail",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "Drive, then see where your tire dust went, and how to shed less.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "build:data": "node scripts/build-data.ts",
    "sample": "node scripts/sample-drive.ts",
    "build:region": "node scripts/build-region.ts",
    "fetch:county": "node scripts/fetch-county.ts",
    "build:county": "node --max-old-space-size=8192 scripts/build-county.ts",
    "build:basemap": "node scripts/basemap/build.ts",
    "build:names": "node scripts/area-names.ts",
    "build:coverage": "node scripts/build-coverage.ts",
    "build:overview": "node scripts/build-overview.ts",
    "build:labels": "node --no-warnings scripts/build-labels.ts",
    "build:majorroads": "node --no-warnings scripts/build-majorroads.ts",
    "build:sea": "node --no-warnings scripts/build-sea.ts",
    "build:state": "node --no-warnings --max-old-space-size=8192 scripts/build-state.ts",
    "build:salmon": "node --no-warnings --max-old-space-size=8192 scripts/build-salmon.ts",
    "agreement": "node scripts/agreement.ts",
    "numbers": "node scripts/numbers.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "firebase": "^13.0.0"
  }
}
